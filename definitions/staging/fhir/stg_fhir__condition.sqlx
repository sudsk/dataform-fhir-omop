config {
  type: "view",
  schema: dataform.projectConfig.vars.stgFhirDataset,
  description: "Flattens the FHIR Condition resource into one row per condition, shaped to feed intermediate/int__observation_conditions.sqlx and omop/condition_occurrence.sqlx."
}

-- Field paths are illustrative of the Analytics V2 export shape - validate
-- against your actual FHIR store's BigQuery export before running against
-- real data.

SELECT
    c.id AS condition_id
    , COALESCE(
        c.subject.patientId,
        REGEXP_EXTRACT(c.subject.reference, r'Patient/(.+)')
    ) AS patient_id
    , COALESCE(
        c.encounter.encounterId,
        REGEXP_EXTRACT(c.encounter.reference, r'Encounter/(.+)')
    ) AS encounter_id

    -- Condition.onset[x] / abatement[x] are FHIR choice types. Analytics V2
    -- materializes each as one RECORD field named after the base ("onset",
    -- "abatement") with sub-fields dateTime/period/age/range/string - NOT
    -- sibling fields onsetDateTime/abatementDateTime. Only the dateTime
    -- sub-field is handled here (the common case); onsetPeriod/onsetAge/
    -- onsetString are a documented gap - condition_start_date will come
    -- back NULL for those.
    , SAFE_CAST(c.onset.dateTime AS DATE) AS condition_start_date
    , SAFE_CAST(c.abatement.dateTime AS DATE) AS condition_stop_date

    -- Condition.code is a single CodeableConcept - take the first coding
    , (SELECT code.code FROM UNNEST(c.code.coding) AS code LIMIT 1) AS condition_code
    , (SELECT code.display FROM UNNEST(c.code.coding) AS code LIMIT 1) AS condition_description

FROM ${ref("Condition")} AS c
