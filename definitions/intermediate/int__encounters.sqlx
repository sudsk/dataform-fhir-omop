config {
  type: "table",
  schema: dataform.projectConfig.vars.intDataset
}

WITH cte_dupes AS (
    /*
    defensive de-duplication: if the same FHIR Encounter.id ever appears more
    than once in stg_fhir__encounter (e.g. a re-exported/updated resource
    version landing as a second row), we can't reliably tell which copy any
    foreign key was meant to reference, so we drop all copies here rather
    than guess and silently produce two visit_occurrence rows for one visit.
    */
    SELECT encounter_id AS dupe_encounter_id
    FROM ${ref("stg_fhir__encounter")}
    GROUP BY encounter_id
    HAVING COUNT(*) > 1
)

SELECT
    e.encounter_id
    , e.encounter_start_datetime
    , e.encounter_start_date
    , e.encounter_stop_datetime
    , e.encounter_stop_date
    , p.person_id
    , pr.provider_id
    , e.payer_id
    , e.encounter_class
    , e.encounter_code
    , e.encounter_description
    , e.base_encounter_cost
    , e.total_encounter_cost
    , e.encounter_payer_coverage
    , e.encounter_reason_code
    , e.encounter_reason_description
FROM ${ref("stg_fhir__encounter")} AS e
LEFT JOIN cte_dupes
    ON e.encounter_id = cte_dupes.dupe_encounter_id
INNER JOIN ${ref("int__person")} AS p
    ON e.patient_id = p.person_source_value
LEFT JOIN ${ref("int__provider")} AS pr
    ON e.provider_id = pr.provider_source_value
WHERE cte_dupes.dupe_encounter_id IS NULL
